// Hotspot the arm tries first (WIFI_BOOT_MODE 0 or 2)
static const char* STA_SSID = "YOUR_HOTSPOT";
static const char* STA_PASS = "YOUR_HOTSPOT_PASSWORD";

// Network the arm creates itself if the hotspot isn't there (mode 0 / 1).
// Join this from your phone, then open http://192.168.4.1/teach
// CHANGE THE PASSWORD — anyone on this network can drive the arm.
static const char* AP_SSID = "ARACHNAE";
static const char* AP_PASS = "pick-a-long-password";

// Password for over-the-air firmware updates (espota.py -a <this>).
// CHANGE IT — anyone on the arm's network who knows it can flash the arm.
static const char* OTA_PASSWORD = "pick-an-ota-password";
